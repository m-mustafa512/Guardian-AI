<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- App name -->
    <TextView
        android:id="@+id/tvNetAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/tvNetDownload"
        android:layout_centerVertical="true" />

    <!-- Download label -->
    <TextView
        android:id="@+id/tvNetDownload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="↓ —"
        android:textColor="#1565C0"
        android:textSize="12sp"
        android:layout_toStartOf="@+id/tvNetUpload"
        android:layout_marginEnd="8dp"
        android:layout_alignBaseline="@+id/tvNetAppName" />

    <!-- Upload label -->
    <TextView
        android:id="@+id/tvNetUpload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="↑ —"
        android:textColor="#E65100"
        android:textSize="12sp"
        android:layout_alignParentEnd="true"
        android:layout_alignBaseline="@+id/tvNetAppName" />

    <!-- Usage progress bar -->
    <ProgressBar
        android:id="@+id/progressNetUsage"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_below="@+id/tvNetAppName"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#1789FB"
        android:progressBackgroundTint="#E0E0E0" />

</RelativeLayout>
