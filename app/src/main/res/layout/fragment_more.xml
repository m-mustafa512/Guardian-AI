<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="More Features"
            android:textColor="#333333"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="8dp" />

        <!-- ═══════════════════════════════════════ -->
        <!-- Row 1: Activity Log                    -->
        <!-- ═══════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardActivityLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <!-- Left icon badge -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/badgeActivityLog"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#E3F2FD"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_stats"
                        android:tint="#1565C0" />

                </androidx.cardview.widget.CardView>

                <!-- Text column -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@+id/badgeActivityLog"
                    android:layout_toStartOf="@+id/chevronActivityLog"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activity Log"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View detailed usage history"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Chevron -->
                <TextView
                    android:id="@+id/chevronActivityLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="›"
                    android:textColor="#BDBDBD"
                    android:textSize="24sp" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══════════════════════════════════════ -->
        <!-- Row 2: Content Filter & Network        -->
        <!-- ═══════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardContentFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <!-- Left icon badge -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/badgeContentFilter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#E8F5E9"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_filter"
                        android:tint="#2E7D32" />

                </androidx.cardview.widget.CardView>

                <!-- Text column -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@+id/badgeContentFilter"
                    android:layout_toStartOf="@+id/chevronContentFilter"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Content Filter &amp; Network"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keyword alerts and data usage"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Chevron -->
                <TextView
                    android:id="@+id/chevronContentFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="›"
                    android:textColor="#BDBDBD"
                    android:textSize="24sp" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Future modules placeholder note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="More features coming soon…"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
