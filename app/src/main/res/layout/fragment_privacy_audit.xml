<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Section 1: Privacy Health Score Card                       -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@android:color/white">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <!-- Left column: label + score + last scan -->
                <LinearLayout
                    android:id="@+id/layoutScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_centerVertical="true">

                    <!-- "PRIVACY HEALTH SCORE" label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRIVACY HEALTH SCORE"
                        android:textColor="#9E9E9E"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <!-- Big score -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/txtPrivacyScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#1A1A1A"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/100"
                            android:textColor="#757575"
                            android:textSize="18sp"
                            android:layout_marginBottom="4dp"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                    <!-- Last scan row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/ic_dot"
                            android:backgroundTint="#43A047"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/txtPrivacyLastScan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last Scan: —"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Right: shield icon badge + circular progress ring -->
                <RelativeLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true">

                    <!-- Circular progress ring (background track) -->
                    <ProgressBar
                        android:id="@+id/progressPrivacyScore"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:progress="100"
                        android:max="100"
                        android:rotation="-90"
                        android:progressDrawable="@drawable/circle_ring_track"
                        android:layout_centerInParent="true" />

                    <!-- Foreground progress ring -->
                    <ProgressBar
                        android:id="@+id/progressPrivacyScoreFg"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:progress="84"
                        android:max="100"
                        android:rotation="-90"
                        android:progressDrawable="@drawable/circle_ring_fg"
                        android:layout_centerInParent="true" />

                    <!-- Shield icon in the center -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_centerInParent="true"
                        app:cardCornerRadius="22dp"
                        app:cardBackgroundColor="#E0F2F1"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_verified_user"
                            android:tint="#00897B" />

                    </androidx.cardview.widget.CardView>

                </RelativeLayout>

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Section 2: Data Categories Row (2 mini cards)             -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data Categories"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Sensitive Access (red) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeColor="#D32F2F"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_warning"
                        android:tint="#D32F2F" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/txtSensitiveCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#D32F2F"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sensitive Access"
                        android:textColor="#D32F2F"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="High risk permissions"
                        android:textColor="#9E9E9E"
                        android:textSize="11sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Normal Access (green) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeColor="#43A047"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_verified_user"
                        android:tint="#43A047" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/txtNormalCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#43A047"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal Access"
                        android:textColor="#43A047"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Standard data usage"
                        android:textColor="#9E9E9E"
                        android:textSize="11sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Section 3: App Analysis header                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Analysis"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerVertical="true" />

            <TextView
                android:id="@+id/btnPrivacyFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Filter ▾"
                android:textColor="#1789FB"
                android:textSize="13sp"
                android:padding="4dp" />

        </RelativeLayout>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Section 4: App list (built programmatically)              -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutPrivacyAppList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Empty state (shown until data loads) -->
            <TextView
                android:id="@+id/txtPrivacyNoApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scanning apps for permission risks…"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="32dp" />

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardian AI · Privacy Audit · Permission risk analysis"
            android:textColor="#BDBDBD"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
