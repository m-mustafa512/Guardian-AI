<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission
        android:name="android.permission.LOCATION_HARDWARE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <package android:name="com.android.settings" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.facebook.katana" />
    </queries>

    <application
        android:name="com.mustafafyp.guardianai.NotificationChannelCreator"
        android:allowBackup="true"
        android:icon="@drawable/child_care_square"
        android:roundIcon="@drawable/child_care"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.NoActionBar">

        <!-- Activities -->
        <activity android:name="com.mustafafyp.guardianai.activities.AboutActivity" />
        <activity android:name="com.mustafafyp.guardianai.activities.SettingsActivity" />
        <activity android:name="com.mustafafyp.guardianai.activities.AccountVerificationActivity" />
        <activity android:name="com.mustafafyp.guardianai.activities.ModeSelectionActivity" />
        <activity android:name="com.mustafafyp.guardianai.activities.PermissionsActivity" />
        <activity android:name="com.mustafafyp.guardianai.activities.BlockedAppActivity" />

        <activity
            android:name="com.mustafafyp.guardianai.activities.ChildDetailsActivity"
            android:parentActivityName="com.mustafafyp.guardianai.activities.ParentSignedInActivity" />

        <activity android:name="com.mustafafyp.guardianai.activities.ChildSignedInActivity" />
        <activity android:name="com.mustafafyp.guardianai.activities.ParentSignedInActivity" />

        <activity
            android:name="com.mustafafyp.guardianai.activities.SignUpActivity"
            android:parentActivityName="com.mustafafyp.guardianai.activities.LoginActivity" />

        <!-- Launcher activity -->
        <activity
            android:name="com.mustafafyp.guardianai.activities.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Services -->
        <service
            android:name="com.mustafafyp.guardianai.services.UploadAppsService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <service
            android:name="com.mustafafyp.guardianai.services.MainForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="com.mustafafyp.guardianai.services.GeoFencingForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Boot Receiver -->
        <receiver
            android:name="com.mustafafyp.guardianai.broadcasts.BootCompleteReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Device Admin Receiver -->
        <receiver
            android:name="com.mustafafyp.guardianai.broadcasts.AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true"
            android:label="@string/device_admin"
            android:description="@string/device_admin_description">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service android:name=".services.GuardianVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
        </service>
        <activity android:name=".activities.WebFilterActivity" />
        <activity android:name=".activities.GenerateQRActivity"
            android:label="Link Device"
            android:parentActivityName=".activities.ParentSignedInActivity"/>

        <activity android:name=".activities.ScanQRActivity"
            android:label="Scan Code"
            android:screenOrientation="portrait"/>
        <activity android:name=".activities.LockScreenActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity android:name=".activities.QuizActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:screenOrientation="portrait"/>

    </application>

</manifest>
